{
  "name": "readwise-even-hub",
  "private": true,
  "license": "MIT",
  "version": "0.6.0",
  "type": "module",
  "description": "Readwise Reader triage and reading on Even Realities G2",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js http://localhost:5173 --automation-port 9898",
    "sim:glow": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js http://localhost:5173 --automation-port 9898 --glow",
    "qr": "evenhub qr --url http://localhost:5173",
    "standin": "node scripts/standin.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "pack:private": "tsc && vite build --mode private && node scripts/pack.mjs --private",
    "beta:prepare": "npm test && npm run pack",
    "beta:prepare:private": "npm test && npm run pack:private"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "happy-dom": "^20.11.1",
    "typescript": "~5.9.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.11.0",
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@evenrealities/pretext": "^0.1.4"
  }
}
